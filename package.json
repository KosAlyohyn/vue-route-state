{
  "name": "vue-route-state",
  "version": "0.7.0",
  "description": "Minimal Vue 3 composables for keeping reactive state in Vue Router query parameters.",
  "license": "MIT",
  "author": {
    "name": "Konstantyn Alyohyn",
    "url": "https://github.com/KosAlyohyn"
  },
  "keywords": [
    "vue",
    "vue3",
    "vue-router",
    "router",
    "url",
    "url-state",
    "query",
    "query-params",
    "composable",
    "state",
    "filters",
    "pagination"
  ],
  "homepage": "https://kosalyohyn.github.io/vue-route-state/",
  "bugs": {
    "url": "https://github.com/KosAlyohyn/vue-route-state/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KosAlyohyn/vue-route-state.git"
  },
  "type": "module",
  "packageManager": "npm@11.12.1",
  "main": "./dist/vue-route-state.cjs",
  "module": "./dist/vue-route-state.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/vue-route-state.js",
      "require": "./dist/vue-route-state.cjs",
      "default": "./dist/vue-route-state.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "playground:dev": "npm --prefix playground run dev",
    "playground:build": "npm --prefix playground run build",
    "playground:preview": "npm --prefix playground run preview",
    "docs:dev": "npm run playground:dev",
    "docs:build": "npm run playground:build",
    "docs:preview": "npm run playground:preview"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  }
}
